{
  "name": "air-defence-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "playtest": "node scripts/playtest.mjs",
    "playtest:campaign": "node scripts/playtest-campaign.mjs",
    "sim": "esbuild scripts/sim-report.ts --bundle --platform=node --format=esm --outfile=playtest/sim.mjs --log-level=warning && node playtest/sim.mjs",
    "harness": "esbuild scripts/threat-harness.ts --bundle --platform=node --format=esm --outfile=playtest/harness.mjs --log-level=warning && node playtest/harness.mjs",
    "campaign": "esbuild scripts/campaign-report.ts --bundle --platform=node --format=esm --outfile=playtest/campaign.mjs --log-level=warning && node playtest/campaign.mjs",
    "war": "esbuild scripts/war-report.ts --bundle --platform=node --format=esm --outfile=playtest/war.mjs --log-level=warning && node playtest/war.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
